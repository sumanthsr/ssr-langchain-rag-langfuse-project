# ═══════════════════════════════════════════════════════════════════
# .env.example — Copy to .env and fill in values for local development
# NEVER commit .env to Git. Use K8s Secrets for production.
# ═══════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────
ENVIRONMENT=dev
DEBUG=true
LOG_LEVEL=DEBUG
APP_VERSION=1.0.0

# ── Qdrant ─────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_documents

# ── Embeddings ─────────────────────────────────────────────────────
EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBED_DEVICE=cpu
EMBED_BATCH_SIZE=32

# ── Chunking ───────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Retrieval ──────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20
RETRIEVAL_FINAL_K=4
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

# ── Ollama (local LLM) ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3
OLLAMA_TEMPERATURE=0.0
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=90

# ── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=true
REDIS_CACHE_TTL=3600

# ── Langfuse (get keys from http://localhost:3000 after first run) ─
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# ── Upload limits ──────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
